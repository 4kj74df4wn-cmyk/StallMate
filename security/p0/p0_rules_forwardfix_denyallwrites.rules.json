{
  "//": "StallMate P0 Phase 2A — FORWARD-FIX EMERGENCY RULES (deny-all-writes containment). STAGING/EMULATOR DESIGN ONLY. HOLD-3 CORRECTED. Use ONLY if BOTH Rules A and Rules B fail for the owner. Fail-closed: NO writes anywhere (no .write grant at any node); bound owner may still READ own data so the shop is not blind while A is repaired in staging. Secure forward posture, NOT a revert to insecure 1339b716.",
  "rules": {
    ".read": false,
    ".write": false,

    "roomOwners": {
      "$roomCode": { ".read": "auth != null && auth.uid === data.val()", ".write": false }
    },

    "rooms": {
      "$roomCode": {
        ".read": "auth != null && auth.uid === root.child('roomOwners').child($roomCode).val()",
        ".write": false
      }
    },

    "trialRegistry": { "$deviceId": { ".read": "auth != null && data.child('boundUid').val() === auth.uid", ".write": false } },
    "licenses":      { ".read": false, ".write": false, "$code": { ".read": "auth != null && data.child('boundTo').val() === auth.uid", ".write": false } },
    "shopProfiles":  { "$ownerId": { ".read": "auth != null && auth.uid === $ownerId", ".write": false } },
    "config":          { ".read": "auth != null", ".write": false },
    "affiliateConfig": { ".read": false, ".write": false },
    "pilotOverrides":  { ".read": false, ".write": false },
    "affiliates":      { ".read": false, ".write": false },
    "referrals":       { ".read": false, ".write": false },
    "dailyLoads":      { ".read": false, ".write": false }
  }
}
